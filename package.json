{
  "name": "plandesk",
  "productName": "PlanDesk",
  "version": "1.0.18",
  "description": "PlanDesk: PDF markup and takeoff for construction drawings",
  "author": "Highline Properties LLC",
  "homepage": "https://highlinepropertiesnc.com/plandesk/",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win --x64 --publish always",
    "store": "electron-builder --win appx --x64 --config store.config.js --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.highlineproperties.plandesk",
    "productName": "PlanDesk",
    "copyright": "© 2026 Highline Properties LLC",
    "files": [
      "main.js",
      "preload.js",
      "printer.js",
      "build/icon.ico"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PlanDesk-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PlanDesk",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jlmcpherson1",
        "repo": "plandesk-windows",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/open-file.ps1",
        "to": "open-file.ps1"
      },
      {
        "from": "build/pdf.ico",
        "to": "pdf.ico"
      },
      {
        "from": "build/fdf.ico",
        "to": "fdf.ico"
      },
      {
        "from": "build/dxf.ico",
        "to": "dxf.ico"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
